{
  "name": "@acemarke/diffloupe",
  "version": "0.1.0",
  "type": "module",
  "description": "Understand your diffs before you merge them",
  "bin": {
    "diffloupe": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "dev:web": "vite --config src/web/vite.config.ts",
    "prebuild": "rm -rf dist",
    "build": "bun build src/index.ts --outdir=dist --target=bun --minify --banner '#!/usr/bin/env -S bun --no-env-file' && bun scripts/copy-assets.ts && bun run build:web",
    "build:web": "vite build --config src/web/vite.config.ts",
    "prepublishOnly": "bun run build && bun run typecheck",
    "test": "bun test src",
    "typecheck": "tsgo --noEmit && bun run typecheck:web",
    "typecheck:web": "tsgo --noEmit -p src/web && tsgo --noEmit -p src/web/tsconfig.test.json",
    "lint": "oxlint src/",
    "release": "release-it"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markerikson/diffloupe.git"
  },
  "keywords": [
    "cli",
    "diff",
    "code-review",
    "ai",
    "git",
    "llm"
  ],
  "author": "Mark Erikson",
  "license": "MIT",
  "devDependencies": {
    "@iconify-json/ph": "^1.2.2",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260127.1",
    "@vitejs/plugin-react": "^5.1.2",
    "bun-types": "^1.3.7",
    "oxlint": "^1.42.0",
    "release-it": "^19.2.4",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.0.0-beta.11"
  },
  "dependencies": {
    "@pierre/diffs": "1.5.2",
    "@reduxjs/toolkit": "^2.11.2",
    "@tanstack/react-router": "^1.170.41",
    "arktype": "^2.1.29",
    "commander": "^14.0.2",
    "hono": "^4.11.7",
    "picocolors": "^1.1.1",
    "react": "^19",
    "react-dom": "^19",
    "react-redux": "^9.2.0",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.26.13"
  }
}
