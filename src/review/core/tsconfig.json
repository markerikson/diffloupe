{
  // Looser than the root tsconfig (no noUncheckedIndexedAccess,
  // exactOptionalPropertyTypes or noPropertyAccessFromIndexSignature).
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noImplicitThis": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "types": ["bun-types"]
  },
  "include": ["./**/*.ts"]
}
